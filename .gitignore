# ============================================================
# .gitignore — pd-speech-crosslingual
# Purpose: keep ONLY source code, configs, safe docs/reports,
# aggregate tables/figures, and reproducibility metadata in Git.
# Never commit environments, raw/private medical data, audio,
# generated experiment outputs, checkpoints, embeddings, or caches.
# ============================================================


# ============================================================
# 1) PYTHON / ENVIRONMENTS / PACKAGE CACHES
# ============================================================
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

.venv/
venv/
env/
ENV/
env_*/
*env*/
**/.venv/
**/venv/
**/env/
**/ENV/
**/env_*/
**/*env*/

# Explicit thesis environments
true_cross_language_vc/env_xtts/
true_cross_language_vc/**/env_xtts/
voice_conversion/**/hifigan_env/
voice_conversion/**/env_*/

# Extra protection against accidentally tracking installed packages
site-packages/
**/site-packages/
Lib/site-packages/
**/Lib/site-packages/

# Python tooling/cache
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.ipynb_checkpoints/
**/.ipynb_checkpoints/
.coverage
coverage.xml
htmlcov/
pip-wheel-metadata/
build/
dist/
*.egg-info/

# Environment variables / secrets
.env
.env.*
!.env.example


